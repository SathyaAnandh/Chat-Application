        "# FINAL PROJECT: Planet Information Manager\n",
        "\n",
        "\n",
        "class Planet:\n",
        "    def __init__(self, name, mass, gravity, distance):\n",
        "\n",
        "        self.__name = name\n",
        "        self.__mass = mass\n",
        "        self.__gravity = gravity\n",
        "        self.__distance = distance\n",
        "\n",
        "\n",
        "    def get_name(self):\n",
        "        return self.__name\n",
        "\n",
        "\n",
        "    def display_info(self):\n",
        "        print(\"\\n--- Planet Information ---\")\n",
        "        print(f\"Name       : {self.__name}\")\n",
        "        print(f\"Mass       : {self.__mass} kg\")\n",
        "        print(f\"Gravity    : {self.__gravity} m/s²\")\n",
        "        print(f\"Distance   : {self.__distance} million km\")\n",
        "        print(\"---------------------------\")\n",
        "\n",
        "\n",
        "\n",
        "planet_list = []\n",
        "\n",
        "\n",
        "\n",
        "def add_planet():\n",
        "    print(\"\\nEnter Planet Details:\")\n",
        "    name = input(\"Name: \")\n",
        "    mass = input(\"Mass (kg): \")\n",
        "    gravity = input(\"Gravity (m/s²): \")\n",
        "    distance = input(\"Distance from Sun (million km): \")\n",
        "\n",
        "    p = Planet(name, mass, gravity, distance)\n",
        "    planet_list.append(p)\n",
        "    print(\"\\nPlanet added successfully! \")\n",
        "\n",
        "\n",
        "\n",
        "def view_planets():\n",
        "    if len(planet_list) == 0:\n",
        "        print(\"\\nNo planets found. Add some first!\")\n",
        "        return\n",
        "\n",
        "    print(\"\\n===== ALL PLANETS =====\")\n",
        "    for idx, planet in enumerate(planet_list):\n",
        "        print(f\"\\nPlanet {idx + 1}:\")\n",
        "        planet.display_info()\n",
        "\n",
        "\n",
        "\n",
        "def search_planet():\n",
        "    search_name = input(\"\\nEnter planet name to search: \").lower()\n",
        "\n",
        "    for planet in planet_list:\n",
        "        if planet.get_name().lower() == search_name:\n",
        "            print(\"\\nPlanet found!\")\n",
        "            planet.display_info()\n",
        "            return\n",
        "\n",
        "    print(\"\\nPlanet not found.\")\n",
        "\n",
        "\n",
        "\n",
        "def delete_planet():\n",
        "    del_name = input(\"\\nEnter planet name to delete: \").lower()\n",
        "\n",
        "    for planet in planet_list:\n",
        "        if planet.get_name().lower() == del_name:\n",
        "            planet_list.remove(planet)\n",
        "            print(\"\\nPlanet deleted successfully!\")\n",
        "            return\n",
        "\n",
        "    print(\"\\nPlanet not found. Try again.\")\n",
        "\n",
        "\n",
        "\n",
        "def menu():\n",
        "    while True:\n",
        "        print(\"\\n==============================\")\n",
        "        print(\"     PLANET INFORMATION MANAGER\")\n",
        "        print(\"==============================\")\n",
        "        print(\"1. Add Planet\")\n",
        "        print(\"2. View All Planets\")\n",
        "        print(\"3. Search Planet\")\n",
        "        print(\"4. Delete Planet\")\n",
        "        print(\"5. Exit\")\n",
        "        print(\"==============================\")\n",
        "\n",
        "        choice = input(\"Enter your choice (1-5): \")\n",
        "\n",
        "        if choice == \"1\":\n",
        "            add_planet()\n",
        "        elif choice == \"2\":\n",
        "            view_planets()\n",
        "        elif choice == \"3\":\n",
        "            search_planet()\n",
        "        elif choice == \"4\":\n",
        "            delete_planet()\n",
        "        elif choice == \"5\":\n",
        "            print(\"\\nExiting Planet Manager... Goodbye!\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"\\nInvalid choice! Please try again.\")\n",
        "\n",
        "\n",
        "\n",
        "menu()\n"
      ]
